---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { HomeStatic, Work, Personal, Contact } from '../components/sections';
import { homeJsonLd } from '../data/seo';
---

<Layout jsonLd={homeJsonLd}>
  <div class="site">
    <Nav />
    <main>
      <div class="page wrap">
        <div class="home">
          <div class="home-main">
            <!-- No client: directive → server-rendered, zero JS shipped -->
            <HomeStatic />
            <Work client:visible />
            <Personal />
            <Contact client:visible />
          </div>
        </div>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
